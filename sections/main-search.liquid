<section class="section-shell"><div class="section-head"><p class="eyebrow">SEARCH</p><h1>FIND YOUR PIECE</h1></div><form action="{{ routes.search_url }}"><input class="search-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products"><button class="btn-primary">SEARCH</button></form>{% if search.performed %}<div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% endfor %}</div>{% endif %}</section>
{% schema %}{"name":"Main search","settings":[]}{% endschema %}