<section class="section-shell">
  <div class="section-head"><p class="eyebrow">SEARCH</p><h1>FIND YOUR PIECE</h1></div>
  <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
    <input class="search-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search Shadow Mafia" aria-label="Search">
    <input type="hidden" name="type" value="product">
    <button class="btn-primary" type="submit">SEARCH →</button>
  </form>

  {% if search.performed %}
    {% paginate search.results by 24 %}
      <div class="product-grid">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}
        {% else %}
          <p>No products found for “{{ search.terms | escape }}”.</p>
        {% endfor %}
      </div>
      {% if paginate.pages > 1 %}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{% endif %}
    {% endpaginate %}
  {% endif %}
</section>
{% schema %}{"name":"Main search","settings":[]}{% endschema %}