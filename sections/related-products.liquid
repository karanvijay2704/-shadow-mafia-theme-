{% assign related_collection = product.collections.first %}
{% if related_collection != blank and related_collection.products.size > 1 %}
<section class="section-shell related-products">
  <div class="section-head">
    <p class="eyebrow">KEEP MOVING</p>
    <h2>YOU MAY ALSO LIKE</h2>
  </div>
  <div class="product-grid">
    {% assign shown = 0 %}
    {% for related_product in related_collection.products %}
      {% unless related_product.id == product.id %}
        {% render 'product-card', product: related_product %}
        {% assign shown = shown | plus: 1 %}
        {% if shown == 4 %}{% break %}{% endif %}
      {% endunless %}
    {% endfor %}
  </div>
</section>
{% endif %}
{% schema %}{"name":"Related products","settings":[]}{% endschema %}