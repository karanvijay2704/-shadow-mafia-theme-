<section class="editorial-block section-shell">
  <div>
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="rte">{{ section.settings.text }}</div>
</section>
{% schema %}
{
  "name":"Editorial brand",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE CODE"},
    {"type":"textarea","id":"heading","label":"Heading","default":"NOT JUST CLOTHES. IT’S A MENTALITY."},
    {"type":"richtext","id":"text","label":"Text","default":"<p>Built for people who move differently. Shadow Mafia blends dark luxury, underground energy and clean streetwear silhouettes into one unmistakable identity.</p>"}
  ],
  "presets":[{"name":"Editorial brand"}]
}
{% endschema %}