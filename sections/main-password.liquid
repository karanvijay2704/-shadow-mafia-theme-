<main class="password-page">
  <div class="password-page__glow"></div>
  <div class="password-page__content">
    <div class="password-brand">
      {% if settings.logo != blank %}
        {{ settings.logo | image_url: width: 280 | image_tag: loading: 'eager' }}
      {% else %}
        <span>SM</span>
        <strong>SHADOW MAFIA</strong>
      {% endif %}
    </div>

    <p class="eyebrow">ACCESS RESTRICTED</p>
    <h1>{{ section.settings.heading }}</h1>

    {% unless shop.password_message == blank %}
      <div class="rte password-message">{{ shop.password_message }}</div>
    {% else %}
      <p class="password-message">{{ section.settings.text }}</p>
    {% endunless %}

    <div class="password-grid">
      <div>
        <h2>ENTER PASSWORD</h2>
        {% form 'storefront_password', class: 'password-form' %}
          {{ form.errors | default_errors }}
          <label for="StorefrontPassword">PASSWORD</label>
          <input id="StorefrontPassword" type="password" name="password" autocomplete="current-password" required>
          <button class="btn-primary" type="submit">ENTER →</button>
        {% endform %}
      </div>

      <div>
        <h2>JOIN THE SIGNAL</h2>
        {% form 'customer', class: 'password-form' %}
          <input type="hidden" name="contact[tags]" value="prospect, password page">
          {% if form.posted_successfully? %}<p class="form-success">You’re on the list.</p>{% endif %}
          {{ form.errors | default_errors }}
          <label for="PasswordEmail">EMAIL</label>
          <input id="PasswordEmail" type="email" name="contact[email]" autocomplete="email" required>
          <button class="btn-secondary" type="submit">NOTIFY ME →</button>
        {% endform %}
      </div>
    </div>
  </div>
</main>
{% schema %}
{
  "name":"Password page",
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"THE DROP IS COMING"},
    {"type":"textarea","id":"text","label":"Text","default":"We’re building something for the ones who walk different. Enter the password or join the list."}
  ]
}
{% endschema %}