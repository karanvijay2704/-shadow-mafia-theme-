<section class="section-shell">
  <div class="section-head">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
  </div>

  <div class="category-grid">
    {% for block in section.blocks %}
      {% assign c = block.settings.collection %}
      <a class="category-card" href="{% if c != blank %}{{ c.url }}{% else %}/collections/all{% endif %}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '320,520,760,1000' }}
        {% elsif c != blank and c.featured_image %}
          {{ c.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '320,520,760,1000' }}
        {% else %}
          <div class="category-fallback"></div>
        {% endif %}
        <span>{% if block.settings.label != blank %}{{ block.settings.label }}{% elsif c != blank %}{{ c.title }}{% else %}COLLECTION{% endif %}</span>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name":"Category grid",
  "max_blocks":6,
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"SHOP BY CATEGORY"},
    {"type":"text","id":"heading","label":"Heading","default":"ENTER THE UNDERGROUND"}
  ],
  "blocks":[
    {
      "type":"category",
      "name":"Category",
      "settings":[
        {"type":"collection","id":"collection","label":"Collection"},
        {"type":"image_picker","id":"image","label":"Custom image"},
        {"type":"text","id":"label","label":"Custom label"}
      ]
    }
  ],
  "presets":[
    {
      "name":"Category grid",
      "blocks":[
        {"type":"category"},{"type":"category"},{"type":"category"},
        {"type":"category"},{"type":"category"},{"type":"category"}
      ]
    }
  ]
}
{% endschema %}