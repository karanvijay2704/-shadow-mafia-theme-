<section class="section-shell">
  <div class="section-head">
    <p class="eyebrow">COLLECTION</p>
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}
  </div>

  {% paginate collection.products by 24 %}
    <div class="product-grid">
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% else %}
        <p>No pieces found in this collection yet.</p>
      {% endfor %}
    </div>
    {% if paginate.pages > 1 %}
      <nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
    {% endif %}
  {% endpaginate %}
</section>
{% schema %}{"name":"Main collection","settings":[]}{% endschema %}