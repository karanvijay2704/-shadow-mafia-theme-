<section class="section-shell product-page" data-product-root>
  <div class="product-gallery" data-product-gallery>
    {% for media in product.media %}
      <div class="product-media-item" data-media-id="{{ media.id }}">
        {% if media.media_type == 'image' %}
          {{ media | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480,720,960,1200,1600', sizes: '(min-width: 981px) 34vw, 100vw' }}
        {% else %}
          {{ media | media_tag }}
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <div class="product-info">
    <p class="eyebrow">SHADOW MAFIA</p>
    <h1>{{ product.title }}</h1>

    {% assign current_variant = product.selected_or_first_available_variant %}
    <div class="product-price-wrap" data-product-price>
      <span class="price">{{ current_variant.price | money }}</span>
      {% if current_variant.compare_at_price > current_variant.price %}
        <s>{{ current_variant.compare_at_price | money }}</s>
      {% endif %}
    </div>

    {% if current_variant.unit_price_measurement %}
      <div class="unit-price" data-unit-price>
        {{ current_variant.unit_price | money }} /
        {% if current_variant.unit_price_measurement.reference_value != 1 %}{{ current_variant.unit_price_measurement.reference_value }}{% endif %}
        {{ current_variant.unit_price_measurement.reference_unit }}
      </div>
    {% endif %}

    {% form 'product', product, class: 'product-form', data-product-form: '' %}
      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <div class="product-form-row">
            <label for="Option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name | upcase }}</label>
            <select id="Option-{{ section.id }}-{{ forloop.index0 }}" data-product-option data-option-index="{{ forloop.index0 }}">
              {% for value in option.values %}
                <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
              {% endfor %}
            </select>
          </div>
        {% endfor %}
      {% endunless %}

      <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

      <div class="product-form-row">
        <label for="Quantity-{{ section.id }}">QUANTITY</label>
        <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1">
      </div>

      <button class="btn-primary full" type="submit" data-add-to-cart {% unless current_variant.available %}disabled{% endunless %}>
        {% if current_variant.available %}ADD TO BAG →{% else %}SOLD OUT{% endif %}
      </button>

      {% if section.settings.show_dynamic_checkout %}
        <div class="dynamic-checkout">{{ form | payment_button }}</div>
      {% endif %}
    {% endform %}

    <div class="product-assurance">
      <span>SECURE CHECKOUT</span>
      <span>FAST SHIPPING</span>
      <span>EASY SUPPORT</span>
    </div>

    <div class="rte product-description">{{ product.description }}</div>

    <details class="product-detail">
      <summary>SHIPPING & DELIVERY</summary>
      <div class="rte">{{ section.settings.shipping_text }}</div>
    </details>
    <details class="product-detail">
      <summary>RETURNS & SUPPORT</summary>
      <div class="rte">{{ section.settings.returns_text }}</div>
    </details>
  </div>

  <script type="application/json" data-product-variants>
    [
      {% for variant in product.variants %}
        {
          "id": {{ variant.id }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | money | json }},
          "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}""{% endif %},
          "media_id": {% if variant.featured_media %}{{ variant.featured_media.id }}{% else %}0{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>
</section>

{% schema %}
{
  "name":"Main product",
  "settings":[
    {"type":"checkbox","id":"show_dynamic_checkout","label":"Show dynamic checkout button","default":true},
    {"type":"richtext","id":"shipping_text","label":"Shipping text","default":"<p>Orders are processed quickly and tracking is shared as soon as your order ships.</p>"},
    {"type":"richtext","id":"returns_text","label":"Returns text","default":"<p>Need help with your order? Contact Shadow Mafia support and we’ll guide you through the next step.</p>"}
  ]
}
{% endschema %}