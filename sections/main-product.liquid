<section class="section-shell product-page">
  <div class="product-gallery">
    {% for media in product.media %}
      {% if media.media_type == 'image' %}
        {{ media | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480,720,960,1200,1400' }}
      {% else %}
        {{ media | media_tag }}
      {% endif %}
    {% endfor %}
  </div>

  <div class="product-info">
    <p class="eyebrow">SHADOW MAFIA</p>
    <h1>{{ product.title }}</h1>
    <div class="price">{{ product.selected_or_first_available_variant.price | money }}</div>

    {% form 'product', product %}
      {% unless product.has_only_default_variant %}
        <div class="product-form-row">
          <label for="Variant-{{ section.id }}">SELECT OPTION</label>
          <select id="Variant-{{ section.id }}" name="id">
            {% for variant in product.variants %}
              <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} — SOLD OUT{% endunless %}
              </option>
            {% endfor %}
          </select>
        </div>
      {% else %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      {% endunless %}

      <div class="product-form-row">
        <label for="Quantity-{{ section.id }}">QUANTITY</label>
        <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1">
      </div>

      <button class="btn-primary full" type="submit" {% unless product.available %}disabled{% endunless %}>
        {% if product.available %}ADD TO BAG →{% else %}SOLD OUT{% endif %}
      </button>
    {% endform %}

    <div class="rte">{{ product.description }}</div>
  </div>
</section>
{% schema %}{"name":"Main product","settings":[]}{% endschema %}