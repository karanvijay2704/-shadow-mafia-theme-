<section class="split-banner section-shell">
  <div class="split-copy">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    <a class="btn-secondary" href="{{ section.settings.link | default: '/collections/women' }}">{{ section.settings.button_label }} →</a>
  </div>

  <div class="split-media">
    {% if section.settings.video != blank %}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'split-video' }}
    {% elsif section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500,800,1100,1400' }}
    {% else %}
      <div class="split-placeholder"></div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name":"Women spotlight",
  "settings":[
    {"type":"video","id":"video","label":"Short loop video"},
    {"type":"image_picker","id":"image","label":"Fallback image"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"FOR HER"},
    {"type":"text","id":"heading","label":"Heading","default":"DARK FEMININITY"},
    {"type":"textarea","id":"text","label":"Text","default":"Sharp silhouettes. Controlled chaos. Pieces that own the room before you say a word."},
    {"type":"text","id":"button_label","label":"Button label","default":"SHOP WOMEN"},
    {"type":"url","id":"link","label":"Link"}
  ],
  "presets":[{"name":"Women spotlight"}]
}
{% endschema %}