{% if section.settings.text != blank %}
  {% if section.settings.link != blank %}<a class="announcement" href="{{ section.settings.link }}">{% else %}<div class="announcement">{% endif %}
    <span>{{ section.settings.text }}</span>
  {% if section.settings.link != blank %}</a>{% else %}</div>{% endif %}
{% endif %}

{% schema %}
{
  "name":"Announcement bar",
  "settings":[
    {"type":"text","id":"text","label":"Text","default":"FREE SHIPPING ON PREPAID ORDERS • WALK DIFFERENT"},
    {"type":"url","id":"link","label":"Link"}
  ]
}
{% endschema %}